generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  user
  admin
}

enum PlanningMode {
  guided
  manual
}

enum Goal {
  weight_loss
  muscle_gain
  maintenance
}

enum ActivityLevel {
  sedentary
  light
  moderate
  active
  very_active
}

enum TDEEFormula {
  mifflin_st_jeor
  harris_benedict
  katch_mcardle
}

enum BiologicalSex {
  male
  female
}

enum MealType {
  breakfast
  lunch
  snacks
  dinner
}

enum ExerciseType {
  push
  pull
  legs
  core
  cardio
  stretch
}

enum UserStatus {
  pending
  approved
  rejected
}

enum FeedbackStatus {
  pending
  in_progress
  resolved
}

enum FeedbackCategory {
  bug
  suggestion
  other
}

model User {
  id                 String         @id @default(cuid())
  email              String?        @unique
  username           String         @unique
  fullName           String?
  password           String?
  role               UserRole       @default(user)
  planningMode       PlanningMode   @default(guided)
  onboardingComplete Boolean        @default(false)
  // PhysicalMetrics — stored flat so they're queryable
  weight             Float?
  height             Float?
  age                Int?
  biologicalSex      BiologicalSex?
  activityLevel      ActivityLevel?
  goal               Goal?
  // MacroTargets — stored flat
  targetCalories     Float?
  targetProtein      Float?
  targetCarbs        Float?
  targetFat          Float?
  status             UserStatus     @default(pending)
  foodEntries        FoodEntry[]
  waterEntries       WaterEntry[]
  nutritionPlans     NutritionPlan[]
  workoutPlans       WorkoutPlan[]
  workoutLog         WorkoutLogEntry[]
  feedback           Feedback[]
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
}

model FoodEntry {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      String   // YYYY-MM-DD
  name      String
  calories  Float
  protein   Float
  carbs     Float
  fat       Float
  mealType  MealType
  createdAt DateTime @default(now())

  @@index([userId, date])
}

model WaterEntry {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      String   // YYYY-MM-DD
  amountMl  Int
  createdAt DateTime @default(now())

  @@index([userId, date])
}

model NutritionPlan {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  meals     Json     // NutritionPlanMeal[]
  createdAt DateTime @default(now())

  @@index([userId])
}

model WorkoutPlan {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  days      Json     // WorkoutDay[]
  createdAt DateTime @default(now())

  @@index([userId])
}

// Global exercise catalog — shared across all users
model ExerciseLibrary {
  id           String            @id @default(cuid())
  name         String            @unique
  muscleGroup  String            @default("")
  type         ExerciseType?
  instructions String?
  logEntries   WorkoutLogEntry[]
  createdAt    DateTime          @default(now())

  @@index([name])
}

model WorkoutLogEntry {
  id                String           @id @default(cuid())
  userId            String
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  date              String           // YYYY-MM-DD
  exerciseId        String
  exerciseName      String
  exerciseLibraryId String?
  exerciseLibrary   ExerciseLibrary? @relation(fields: [exerciseLibraryId], references: [id], onDelete: SetNull)
  sets              Json             // WorkoutSet[]
  createdAt         DateTime         @default(now())

  @@index([userId, date])
}

// Singleton row — always id = "global"
model GlobalSettings {
  id          String      @id @default("global")
  tdeeFormula TDEEFormula @default(mifflin_st_jeor)
}

model Feedback {
  id         String           @id @default(cuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      String
  category   FeedbackCategory @default(other)
  message    String
  status     FeedbackStatus   @default(pending)
  adminNote  String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@index([userId])
  @@index([status])
}

// Cache for USDA FoodData Central search results — populated on first search, never updated
model FoodCache {
  fdcId           Int      @id
  name            String
  brand           String?
  // macros per 100g
  calories        Float
  protein         Float
  carbs           Float
  fat             Float
  servingUnit     String   @default("g")
  gramsPerServing Float    @default(100)
  createdAt       DateTime @default(now())

  @@index([name])
}
